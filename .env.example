# Database
DATABASE_URL="file:./db/custom.db"

# Supabase
SUPABASE_URL="https://your-project.supabase.co"
SUPABASE_PUBLISHABLE_KEY="your-publishable-key"
SUPABASE_SECRET_KEY="your-secret-key"
SUPABASE_JWKS_URL="https://your-project.supabase.co/auth/v1/.well-known/jwks.json"
NEXT_PUBLIC_SUPABASE_URL="https://your-project.supabase.co"
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY="your-publishable-key"

# Site URL — used for canonical URLs, metadata, and CORS.
# Local development:
NEXT_PUBLIC_SITE_URL="http://localhost:3000"
# Production (set in the Vercel dashboard):
# NEXT_PUBLIC_SITE_URL="https://jk-ai-agent.vercel.app"

# Authentication (next-auth)
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="generate-a-random-secret-here"

# ── JK-TECH-CODE AI BRAIN · Primary LLM (DeepSeek) ─────────────────────
# Set DEEPSEEK_API_KEY to enable real ChatGPT-quality answers via the
# DeepSeek LLM API (OpenAI-compatible). DeepSeek is cheap and strong:
#   deepseek-chat      = DeepSeek-V3 (general chat)
#   deepseek-reasoner  = DeepSeek-R1 (step-by-step reasoning)
DEEPSEEK_API_KEY=""
DEEPSEEK_MODEL="deepseek-chat"
# DEEPSEEK_BASE_URL="https://api.deepseek.com"

# ── JK-TECH-CODE AI BRAIN · Search Engine ─────────────────────────────
# The Brain answers with web-search evidence when no LLM key is set, and uses
# web results as live context alongside DeepSeek. Provide at least one key:
#   TAVILY_API_KEY  — Tavily (recommended; designed for agentic search)
#   SERPAPI_API_KEY — SerpAPI (Google results fallback engine)
TAVILY_API_KEY=""
SERPAPI_API_KEY=""

# Optional overall request timeout safety net (ms). 0 disables.
# LLM_TIMEOUT_MS=120000

# Secondary search keys (optional, unused by the Brain's evidence pipeline)
BRAVE_API_KEY=""
BING_API_KEY=""

# Optional: Image Generation API Keys
STABILITY_API_KEY=""
REPLICATE_API_KEY=""

# Optional: Embedding fallback provider (local, no key needed)
EMBEDDING_PROVIDER="fallback"

# Optional: Monitoring
SENTRY_DSN=""

# Deployment
NODE_ENV="development"
PORT=3000
