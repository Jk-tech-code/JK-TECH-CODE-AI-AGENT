# Database
DATABASE_URL="file:./db/custom.db"

# Supabase
SUPABASE_URL="https://wkqunwndzfzcbagvslym.supabase.co"
SUPABASE_PUBLISHABLE_KEY="your-publishable-key"
SUPABASE_SECRET_KEY="your-secret-key"
SUPABASE_JWKS_URL="https://wkqunwndzfzcbagvslym.supabase.co/auth/v1/.well-known/jwks.json"
NEXT_PUBLIC_SUPABASE_URL="https://wkqunwndzfzcbagvslym.supabase.co"
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY="your-publishable-key"

# Site URL — used for canonical URLs, metadata, and CORS.
# Local development:
NEXT_PUBLIC_SITE_URL="http://localhost:3000"
# Production (set in the Vercel dashboard):
# NEXT_PUBLIC_SITE_URL="https://jk-ai-agent.vercel.app"

# Authentication (next-auth)
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="generate-a-random-secret-here"

# Model API Keys (z-ai-web-dev-sdk)
ZAI_API_KEY="your-zai-api-key"

# Optional: Embedding Provider (openai, voyage, cohere, gemini, fallback)
EMBEDDING_PROVIDER="fallback"
VOYAGE_API_KEY=""
COHERE_API_KEY=""
GEMINI_API_KEY=""

# Optional: Secondary Search Engine Keys
BRAVE_API_KEY=""
SERPAPI_API_KEY=""
BING_API_KEY=""

# Optional: Image Generation API Keys
OPENAI_API_KEY=""
STABILITY_API_KEY=""
REPLICATE_API_KEY=""

# Optional: Monitoring
SENTRY_DSN=""

# Deployment
NODE_ENV="development"
PORT=3000

# ── JK-TECH-CODE AI BRAIN · LLM Provider ─────────────────────────────
# Primary LLM backend. Provider is selected via LLM_PROVIDER:
#   "gemini"     (default) — Google Gemini, works on Vercel / cloud (no local service)
#   "ollama"                — local Ollama + Qwen3 (local development)
#   "openai"                — OpenAI
#   "groq"                  — Groq (fast inference)
#   "openrouter"            — OpenRouter unified gateway
#   "anthropic"             — Anthropic Claude
#   "together"              — Together AI
LLM_PROVIDER="gemini"

# Automatic fallback to the next configured provider when the active one fails
# with a retryable error (rate limit / outage). Chain order (default):
#   gemini → groq → openrouter → openai → anthropic → together → ollama
# Override the chain with a comma-separated list of provider names.
LLM_FALLBACK_ENABLED="false"
# LLM_FALLBACK_ORDER="gemini,groq,openrouter,openai,anthropic,together,ollama"
# Optional overall request timeout safety net (ms). 0 disables. Each provider
# already applies its own *_TIMEOUT_MS.
# LLM_TIMEOUT_MS=120000

# Gemini (default provider — required for cloud/Vercel deployments)
GEMINI_API_KEY=""
GEMINI_MODEL="gemini-2.5-flash"
# Optional: custom Gemini-compatible endpoint
# GEMINI_BASE_URL="https://generativelanguage.googleapis.com"
GEMINI_TIMEOUT_MS=60000
GEMINI_MAX_RETRIES=2

# Ollama (local development only — set LLM_PROVIDER="ollama" to enable)
# OLLAMA_HOST="http://localhost:11434"
# OLLAMA_MODEL="qwen3:4b"
# OLLAMA_MODEL="qwen3:8b"
# OLLAMA_MODEL="qwen3:14b"
# OLLAMA_TIMEOUT_MS=60000
# OLLAMA_MAX_RETRIES=2

# OpenAI (set LLM_PROVIDER="openai" to enable)
# OPENAI_API_KEY=""
# OPENAI_MODEL="gpt-4.1"
# OPENAI_BASE_URL="https://api.openai.com/v1"
# OPENAI_TIMEOUT_MS=60000
# OPENAI_MAX_RETRIES=2

# Groq (set LLM_PROVIDER="groq" to enable)
# GROQ_API_KEY=""
# GROQ_MODEL="llama-3.3-70b-versatile"
# GROQ_BASE_URL="https://api.groq.com/openai/v1"
# GROQ_TIMEOUT_MS=60000
# GROQ_MAX_RETRIES=2

# OpenRouter (set LLM_PROVIDER="openrouter" to enable)
# OPENROUTER_API_KEY=""
# OPENROUTER_MODEL="google/gemini-2.5-flash"
# OPENROUTER_BASE_URL="https://openrouter.ai/api/v1"
# OPENROUTER_TIMEOUT_MS=60000
# OPENROUTER_MAX_RETRIES=2

# Anthropic Claude (set LLM_PROVIDER="anthropic" to enable)
# ANTHROPIC_API_KEY=""
# ANTHROPIC_MODEL="claude-sonnet-4-20250514"
# ANTHROPIC_BASE_URL="https://api.anthropic.com"
# ANTHROPIC_TIMEOUT_MS=60000
# ANTHROPIC_MAX_RETRIES=2

# Together AI (set LLM_PROVIDER="together" to enable)
# TOGETHER_API_KEY=""
# TOGETHER_MODEL="meta-llama/Llama-3.3-70B-Instruct-Turbo"
# TOGETHER_BASE_URL="https://api.together.xyz/v1"
# TOGETHER_TIMEOUT_MS=60000
# TOGETHER_MAX_RETRIES=2
